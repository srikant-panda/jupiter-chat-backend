# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/jupiter-chat

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# AI Provider Configuration
# Multiple API keys can be supplied as comma-separated values (e.g. key1,key2,key3)
# Requests are evenly distributed using Smooth Weighted Round-Robin
# Any rate-limited key (429) is temporarily blacklisted for API_KEY_COOLDOWN_HOURS
OPENROUTER_API_KEY=your_openrouter_api_key_1,your_openrouter_api_key_2
GROQ_API_KEY=your_groq_api_key_1,your_groq_api_key_2
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2

# Key Pool & Timeout Configuration
API_KEY_COOLDOWN_HOURS=4
# Failover timeout when multiple providers are available (ms)
PROVIDER_TIMEOUT_MS=12000
# Extended wait timeout when only one provider is available or on final provider (ms)
SINGLE_PROVIDER_TIMEOUT_MS=60000

# Default model: 'openrouter/free' (or 'free') dynamically balances across active free tiers with auto-failover
DEFAULT_AI_MODEL=openrouter/free
OPENROUTER_FREE_MODEL=openrouter/free
GROQ_FREE_MODEL=openai/gpt-oss-120b
GEMINI_FREE_MODEL=gemini-3.5-flash

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/login/google/callback

# Environment & CORS Settings
# Set to true for local development (allows localhost/LAN IPs and relaxed cookie security)
LOCAL_TEST=true
# Set to true in production for HTTPS and SameSite=None; Secure cookies
PRODUCTION=false
# Comma-separated allowed frontend browser origins (required when LOCAL_TEST=false)
VITE_FRONTEND_URL=https://jupiter-chat.example.com
