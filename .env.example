# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/jupiter-chat

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# AI Provider Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Fallback model when no model is specified in the request
DEFAULT_AI_MODEL=openai/gpt-4o-mini

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/login/google/callback

# Environment & CORS Settings
# Set to true for local development (allows localhost/LAN IPs and relaxed cookie security)
LOCAL_TEST=true
# Set to true in production for HTTPS and SameSite=None; Secure cookies
PRODUCTION=false
# Comma-separated allowed frontend browser origins (required when LOCAL_TEST=false)
VITE_FRONTEND_URL=https://jupiter-chat.example.com
